# ==========================================
# PagePulse Repository Root Gitignore
# ==========================================

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / Text Editors
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# Databases / Data caches
*.sqlite3
*.db
*.localdb

# ==========================================
# Backend Configs (FastAPI / Python)
# ==========================================
backend/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
backend/.pytest_cache/
backend/.venv/
backend/venv/
backend/env/
backend/dist/
backend/build/
backend/*.egg-info/
backend/.eggs/
backend/.coverage
backend/htmlcov/
backend/.mypy_cache/

# ==========================================
# Frontend Configs (React / Node)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.eslintcache
frontend/vite.svg
